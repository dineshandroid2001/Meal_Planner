
/**
 * @fileoverview Firestore Security Rules for Roommate Meal Plans.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for roommate profiles and an admin-ownership model for meal plans.
 * Data integrity is maintained through denormalized authorization and invariants.
 *
 * Data Structure:
 * - /roommates/{roommateId}: Stores private roommate profiles, accessible only to the owner.
 * - /monthlyPlans/{mealPlanId}: Stores meal plan details, accessible only to the admin who created it.
 * - /monthlyPlans/{mealPlanId}/participations/{participationId}: Stores participation records, accessible to the owner (roommate) or meal plan admin.
 * - /reimbursements/{reimbursementId}: Stores reimbursement requests, accessible to the owner (roommate) or an admin.
 * - /auditLogs/{auditLogId}: Stores audit logs for server-side functions.
 *
 * Key Security Decisions:
 * - Roommate profiles are private to the owner but readable by other logged-in users to facilitate admin actions.
 * - Meal plans are managed by admins, who have full control.
 * - Reimbursement requests can be managed by their owner or an admin.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Helper Functions ---

    /**
     * Checks if the currently authenticated user is the owner of a document.
     * @param docOwnerId The UID of the document owner.
     * @returns {boolean} True if the request is authenticated and the UID matches the owner's ID.
     */
    function isOwner(docOwnerId) {
      return request.auth != null && request.auth.uid == docOwnerId;
    }

    /**
     * Checks if the currently authenticated user has the 'isAdmin' flag set to true
     * in their own roommate profile document.
     * @returns {boolean} True if the user is an admin.
     */
    function userIsAdmin() {
      // This requires that any authenticated user can read the `isAdmin` field from any other user's profile.
      return request.auth != null && get(/databases/$(database)/documents/roommates/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Collection Rules ---

    /**
     * @description Manages roommate profiles.
     * @path /roommates/{roommateId}
     * @allow (get, list) - Any authenticated user can read roommate profiles. This is necessary for the global `userIsAdmin()` check to function correctly.
     * @allow (write, delete) - Only the profile owner or an admin can modify or delete a profile.
     */
    match /roommates/{roommateId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow write: if isOwner(roommateId) || userIsAdmin();
      allow delete: if isOwner(roommateId) || userIsAdmin();
    }

    /**
     * @description Manages monthly meal plans with admin-only write access.
     * @path /monthlyPlans/{mealPlanId}
     * @allow (get, list) - Any authenticated user can read meal plan details.
     * @allow (write) - Only an admin can create or update a meal plan.
     */
    match /monthlyPlans/{mealPlanId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow write: if userIsAdmin();
    }

    /**
     * @description Manages participation records within a meal plan.
     * @path /monthlyPlans/{mealPlanId}/participations/{participationId}
     * @allow (get, list) - Any authenticated user can read participation data.
     * @allow (write) - A user can update their own participation record, or an admin can update any record.
     */
    match /monthlyPlans/{mealPlanId}/participations/{participationId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow write: if isOwner(participationId) || userIsAdmin();
    }

    /**
     * @description Manages reimbursement requests.
     * @path /reimbursements/{reimbursementId}
     * @allow (get, list) - Any authenticated user can read requests.
     * @allow (create) - A user can create a reimbursement request for themselves.
     * @allow (update) - A user can update their own PENDING request. An admin can update any request.
     * @allow (delete) - A user can delete their own request IF it's not approved. An admin can delete any request IF it's not approved.
     */
    match /reimbursements/{reimbursementId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if isOwner(request.resource.data.roommateId);
      allow update: if (isOwner(resource.data.roommateId) && resource.data.status == 'pending') || userIsAdmin();
      allow delete: if (isOwner(resource.data.roommateId) && resource.data.status != 'approved') || (userIsAdmin() && resource.data.status != 'approved');
    }

    /**
     * @description Manages audit logs with write-only access for server-side functions.
     * @path /auditLogs/{auditLogId}
     * @principle Restricts access to audit logs to server-side functions only.
     */
    match /auditLogs/{auditLogId} {
      allow read: if false;
      allow write: if false; // Should be locked down to server-side calls in a real production environment.
    }
    
    /**
     * @description Manages a global configuration document for the app.
     * @path /app-config/admin
     * @allow (read) - Anyone can read the admin config.
     * @allow (write) - Write is allowed only if the document doesn't exist (initial setup) or if the user is already an admin.
     */
    match /app-config/admin {
        allow read: if true;
        allow write: if get(/databases/$(database)/documents/app-config/admin) == null || userIsAdmin();
    }
  }
}
