/**
 * @fileoverview Firestore Security Rules for Roommate Meal Plans.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for roommate profiles and an admin-ownership model for meal plans.
 * Data integrity is maintained through denormalized authorization and invariants.
 *
 * Data Structure:
 * - /roommates/{roommateId}: Stores private roommate profiles, accessible only to the owner.
 * - /monthlyPlans/{mealPlanId}: Stores meal plan details, accessible only to the admin who created it.
 * - /monthlyPlans/{mealPlanId}/participations/{participationId}: Stores participation records, accessible to the owner (roommate) or meal plan admin.
 * - /reimbursements/{reimbursementId}: Stores reimbursement requests, accessible only to the owner (roommate).
 * - /auditLogs/{auditLogId}: Stores audit logs, accessible to the admin.
 *
 * Key Security Decisions:
 * - Roommate profiles are strictly private (owner-only access).
 * - Meal plans are managed by admins, who have full control.
 * - Listing of roommates is disallowed to protect user privacy.
 *
 * Denormalization for Authorization:
 * - MealPlan.adminId: The ID of the admin user is stored directly on the meal plan to avoid needing to read the /roommates collection for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages roommate profiles with owner-only access.
     * @path /roommates/{roommateId}
     * @allow (create) - A user can create their own profile if the roommateId matches their auth UID. An admin can create profiles for others.
     * @allow (get, update, delete) - A user can read, update, or delete their own profile if the roommateId matches their auth UID.
     * @deny (create) - A user cannot create a profile for another user (roommateId does not match auth UID).
     * @deny (get, update, delete) - A user cannot read, update, or delete another user's profile (roommateId does not match auth UID).
     * @principle Enforces document ownership for all operations.
     */
    match /roommates/{roommateId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == roommateId;
      }

      function userIsAdmin() {
        // Check the isAdmin flag on the user's own roommate document.
        return request.auth != null && get(/databases/$(database)/documents/roommates/$(request.auth.uid)).data.isAdmin == true;
      }

      allow get: if request.auth != null;
      allow list: if request.auth != null;
      
      // Allow owners to create/update their own profile.
      // Allow admins to create/update any profile.
      allow write: if isOwner() || userIsAdmin();
      
      // Allow owners to delete their own profile.
      allow delete: if isOwner() || userIsAdmin();
    }

    /**
     * @description Manages meal plans with admin-only access.
     * @path /monthlyPlans/{mealPlanId}
     * @allow (create) - An admin can create a meal plan if their UID matches the adminId in the plan.
     * @allow (get, update, delete) - An admin can read, update, or delete a meal plan if their UID matches the adminId in the plan.
     * @deny (create) - A non-admin user cannot create a meal plan.
     * @deny (get, update, delete) - A non-admin user cannot read, update, or delete a meal plan.
     * @principle Enforces admin-only access based on the 'adminId' field in the document.
     */
    match /monthlyPlans/{mealPlanId} {
      function userIsAdmin() {
        return get(/databases/$(database)/documents/roommates/$(request.auth.uid)).data.isAdmin == true;
      }

      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow write: if userIsAdmin() && (request.resource.data.adminId == request.auth.uid || resource.data.adminId == request.auth.uid);
    }

    /**
     * @description Manages participation records within a meal plan.
     * @path /monthlyPlans/{mealPlanId}/participations/{participationId}
     * @allow (create) - A user can create a participation record if they are the owner (roommate) or the meal plan admin.
     * @allow (get, list, update, delete) - A user can read, list, update, or delete their own participation record if they are the owner (roommate) or the meal plan admin.
     * @deny (create) - A user cannot create a participation record for another user unless they are the meal plan admin.
     * @deny (get, list, update, delete) - A user cannot read, list, update, or delete another user's participation record unless they are the meal plan admin.
     * @principle Enforces ownership and admin-based access control for participation records.
     */
    match /monthlyPlans/{mealPlanId}/participations/{participationId} {
      function isRoommate() {
        return request.auth != null && request.auth.uid == participationId;
      }

      function userIsAdmin() {
        return get(/databases/$(database)/documents/roommates/$(request.auth.uid)).data.isAdmin == true;
      }

      allow get: if isRoommate() || userIsAdmin();
      allow list: if request.auth != null;
      allow write: if isRoommate() || userIsAdmin();
    }

    /**
     * @description Manages reimbursement requests.
     * @path /reimbursements/{reimbursementId}
     * @allow (create) - A user can create a reimbursement request for themselves.
     * @allow (get, list, update, delete) - A user can read, list, update, or delete their own reimbursement request.
     * @deny (create) - A user cannot create a reimbursement request for another user.
     * @deny (get, list, update, delete) - A user cannot read, list, update, or delete another user's reimbursement request.
     * @principle Enforces ownership-based access control for reimbursement requests.
     */
    match /reimbursements/{reimbursementId} {
      function isRoommate(roommateId) {
        return request.auth != null && request.auth.uid == roommateId;
      }
      
      function userIsAdmin() {
        return request.auth != null && get(/databases/$(database)/documents/roommates/$(request.auth.uid)).data.isAdmin == true;
      }

      allow get: if isRoommate(resource.data.roommateId);
      allow list: if request.auth != null;
      allow create: if isRoommate(request.resource.data.roommateId);
      allow update: if isRoommate(resource.data.roommateId) || userIsAdmin();
      allow delete: if userIsAdmin();
    }

    /**
     * @description Manages audit logs with write-only access for server-side functions.
     * @path /auditLogs/{auditLogId}
     * @allow (create) - Allows server-side functions to create audit log entries.
     * @deny (get, list, update, delete) - No user can read, list, update, or delete audit logs.
     * @principle Restricts access to audit logs to server-side functions only.
     */
    match /auditLogs/{auditLogId} {
      allow get: if false;
      allow list: if false;
      allow create: if true; // Allow all authenticated users to create audit logs. Should be secured via backend only.
      allow update: if false;
      allow delete: if false;
    }
    
    match /app-config/admin {
        allow read: if true;
        allow write: if get(/databases/$(database)/documents/app-config/admin) == null; // only allow write if doc doesn't exist
    }
  }
}
